# Copy to .env (git-ignored) and fill in.
BROWSERSTACK_USERNAME= 
BROWSERSTACK_ACCESS_KEY= 
# Set by the pipeline's "Upload APK" step (bs://...). For local runs, upload the APK
# from docs/assets/ yourself and paste the bs:// id here.
BROWSERSTACK_APP_URL= 
# Comma-separated feature list; empty = full flow
# FEATURES=gps,network
# Test data used when registering in the app (do not hardcode in specs)
REGISTER_NAME=
REGISTER_EMAIL=
REGISTER_PASSWORD=
PHONE_NUMBER=
OTP_VALUE=
